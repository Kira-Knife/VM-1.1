                "tags": [
                    "groups"
                ],
                "summary": "Получить сгруппированные инциденты",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Starting alert index",
                        "name": "begin",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Number of alerts",
                        "name": "count",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
