                "tags": [
                    "heatmap"
                ],
                "summary": "Получение данных по созданным алертами и инцидентам за все прошедшие дни в виде списка по дням",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
